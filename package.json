{
  "name": "allertameteotoscanabot",
  "version": "2.0.0",
  "description": "Bot Telegram per allerte meteo della Toscana",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "tsx src/dev.ts",
    "deploy": "wrangler deploy",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed-comuni.ts",
    "webhook": "tsx scripts/webhook.ts",
    "commands": "tsx scripts/set-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Daniele Zeolla",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.8.0",
    "grammy": "^1.43.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.103.0"
  }
}
